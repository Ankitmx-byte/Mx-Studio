# ==============================================================================
# Mx Studio - Environment Configuration Template
# All values are placeholders for local/production configuration.
# NEVER commit actual secrets or credentials to source control.
# ==============================================================================

# Application
NEXT_PUBLIC_APP_NAME="Mx Studio"
NEXT_PUBLIC_APP_TAGLINE="Create Beyond Limits."
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Authentication & Session
NEXTAUTH_SECRET="your_nextauth_secret_min_32_chars_placeholder"
NEXTAUTH_URL="http://localhost:3000"

# Backend & Database (PostgreSQL / Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/mx_studio?schema=public"

# Redis & Background Queue (BullMQ)
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# AI Microservices (FastAPI)
AI_SERVICE_API_URL="http://localhost:8000"
AI_SERVICE_API_KEY="placeholder_internal_ai_service_token"

# External AI Providers (Placeholders)
OPENAI_API_KEY="placeholder_openai_api_key"
ANTHROPIC_API_KEY="placeholder_anthropic_api_key"
REPLICATE_API_TOKEN="placeholder_replicate_api_token"
RUNWAY_API_KEY="placeholder_runway_api_key"
ELEVENLABS_API_KEY="placeholder_elevenlabs_api_key"

# Cloudflare R2 / S3 Media Storage
R2_ACCOUNT_ID="placeholder_cloudflare_account_id"
R2_ACCESS_KEY_ID="placeholder_r2_access_key_id"
R2_SECRET_ACCESS_KEY="placeholder_r2_secret_access_key"
R2_BUCKET_NAME="mx-studio-media"
R2_PUBLIC_DOMAIN="https://media.mxstudio.dev"

# Stripe Billing & Credits
STRIPE_SECRET_KEY="sk_test_placeholder_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_placeholder_stripe_webhook_key"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_placeholder_stripe_publishable_key"

# Observability & Monitoring
NEXT_PUBLIC_SENTRY_DSN="https://placeholder_sentry_dsn@sentry.io/0"
SENTRY_AUTH_TOKEN="placeholder_sentry_auth_token"

